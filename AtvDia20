import java.util.Scanner;
public class Atv20 {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);

        System.out.println("Deposite uma quantidade de dinheiro:");

        double valor = scan.nextDouble();

        System.out.println("Quanto voce quer sacar?");

        double sacar = scan.nextDouble();

        double taxa1 = valor * 0.05;
        double taxa2 = taxa1 + sacar;
        double saque = valor - taxa2;

        System.out.println("Depois do saque seu valor na conta sera " + saque + " Reais.");
    }
}
